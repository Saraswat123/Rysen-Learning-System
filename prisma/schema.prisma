generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDUCATOR
  PRINCIPAL
}

enum QuestionType {
  MCQ
  TEXT
}

model Branch {
  id           String        @id @default(cuid())
  name         String
  location     String
  createdAt    DateTime      @default(now())
  users        User[]
  students     Student[]
  studentTests StudentTest[]
  resources    Resource[]
}

model Resource {
  id          String         @id @default(cuid())
  title       String
  description String?
  url         String?
  type        String         @default("LINK")
  category    String         @default("General")
  isPublished Boolean        @default(true)
  isPinned    Boolean        @default(false)
  branchId    String?
  branch      Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  groupId     String?
  group       EducatorGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model EducatorGroup {
  id          String                @id @default(cuid())
  name        String
  description String?
  color       String                @default("#033D4C")
  members     EducatorGroupMember[]
  resources   Resource[]
  messages    GroupMessage[]
  recognitionCategory RecognitionCategory?
  createdAt   DateTime              @default(now())
}

model GroupMessage {
  id        String        @id @default(cuid())
  groupId   String
  group     EducatorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime      @default(now())
}

model EducatorGroupMember {
  id        String        @id @default(cuid())
  groupId   String
  group     EducatorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([groupId, userId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  avatarUrl String?
  password      String?
  passwordSetAt DateTime?
  role      Role     @default(EDUCATOR)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdBy String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress          StageProgress[]
  sessions          Session[]
  textResponses     TextResponse[]
  enrollments       ProgramEnrollment[]
  createdTaskGroups TaskGroup[]          @relation("TaskGroupCreator")
  createdTasks      Task[]               @relation("TaskCreator")
  taskAssignments   TaskAssignment[]     @relation("TaskAssignee")
  taskComments      TaskComment[]        @relation("TaskCommenter")
  notifications     Notification[]       @relation("NotificationRecipient")
  educatorGroups    EducatorGroupMember[]
  groupMessages     GroupMessage[]
  ratings           EducatorRating[] @relation("RatedEducator")
  ratingsGiven      EducatorRating[] @relation("RatingCreator")
}

// A named recognition programme (e.g. "STEM Educators") scoped to one EducatorGroup's
// members, with its own admin-editable list of rating criteria.
model RecognitionCategory {
  id        String            @id @default(cuid())
  name      String
  groupId   String            @unique
  group     EducatorGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  criteria  RatingCriterion[]
  ratings   EducatorRating[]
  createdAt DateTime          @default(now())
}

// One scoreable line item within a category (e.g. "STEM Kit Completion").
// isAutoTest = true marks the one criterion computed live from student test data
// instead of admin-entered — never stored as a manual score.
model RatingCriterion {
  id         String              @id @default(cuid())
  categoryId String
  category   RecognitionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label      String
  order      Int                 @default(0)
  isAutoTest Boolean             @default(false)
  createdAt  DateTime            @default(now())
}

// Monthly rating for one educator within one recognition category.
// scores is a { [criterionId]: number(0-10) } map — dynamic since criteria can be
// added/edited/removed per category. The isAutoTest criterion is never a key here;
// it's computed live at query time from that educator's branch's StudentAttempt data.
model EducatorRating {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation("RatedEducator", fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    RecognitionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  period      String              // "YYYY-MM"
  scores      Json                @default("{}")
  comment     String?
  ratedById   String
  ratedBy     User                @relation("RatingCreator", fields: [ratedById], references: [id])
  finalized   Boolean             @default(false)
  finalizedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([userId, categoryId, period])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Program {
  id           String   @id @default(cuid())
  name         String
  description  String?
  isPublished  Boolean  @default(false)
  applicableTo String   @default("BOTH")
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  stages       Stage[]
  enrollments  ProgramEnrollment[]
}

model ProgramEnrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([userId, programId])
}

model Stage {
  id               String   @id @default(cuid())
  programId        String?
  program          Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  number           Int
  title            String
  subtitle         String?
  description      String?
  week             String?
  docUrl           String?
  docs             Json     @default("[]")
  weeks            Json     @default("[]")
  applicableTo     String   @default("BOTH")
  timeLimitMinutes Int      @default(30)
  passScore        Int      @default(70)
  maxAttempts      Int      @default(3)
  badgeTitle       String?
  badgeColor       String   @default("#FECB08")
  badgeIcon        String   @default("award")
  isPublished      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  progress  StageProgress[]
}

model Question {
  id          String       @id @default(cuid())
  stageId     String
  stage       Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  type        QuestionType @default(MCQ)
  text        String
  options     Json         @default("[]")
  correctId   String       @default("")
  explanation String?
  order       Int          @default(0)
  docGroupId  String?

  createdAt     DateTime       @default(now())
  textResponses TextResponse[]
}

model TextResponse {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, questionId])
}

model Student {
  id        String   @id @default(cuid())
  name      String
  class     String
  section   String   @default("")
  subject   String   @default("")
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  sessions StudentSession[]
  attempts StudentAttempt[]
}

model StudentSession {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model StudentTest {
  id               String   @id @default(cuid())
  title            String
  description      String?
  subject          String   @default("")
  targetClass      String   @default("")
  timeLimitMinutes Int      @default(30)
  passScore        Int      @default(60)
  isPublished      Boolean  @default(false)
  order            Int      @default(0)
  createdBy        String   @default("ADMIN")
  branchId         String?
  branch           Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  questions StudentQuestion[]
  attempts  StudentAttempt[]
}

model StudentQuestion {
  id          String  @id @default(cuid())
  testId      String
  test        StudentTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  type        String  @default("MCQ")
  text        String
  imageUrl    String?
  videoUrl    String?
  options     Json    @default("[]")
  correctId   String  @default("")
  explanation String?
  order       Int     @default(0)
  marks       Int     @default(1)
}

model StudentAttempt {
  id          String      @id @default(cuid())
  studentId   String
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testId      String
  test        StudentTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  score       Int         @default(0)
  totalMarks  Int         @default(0)
  passed      Boolean     @default(false)
  answers     Json        @default("{}")
  completedAt DateTime    @default(now())
}

model TaskGroup {
  id          String   @id @default(cuid())
  title       String
  description String?
  color       String   @default("#033D4C")
  createdById String
  createdBy   User     @relation("TaskGroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  tasks       Task[]
}

model Task {
  id          String    @id @default(cuid())
  groupId     String?
  group       TaskGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  title       String
  description String?
  notes       String?
  deadline    DateTime?
  priority    String    @default("NORMAL")
  visibility  String    @default("ALL_ADMINS")
  createdById String
  createdBy   User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subtasks    SubTask[]
  resources   TaskResource[]
  assignments TaskAssignment[]
  comments    TaskComment[]
}

model SubTask {
  id        String            @id @default(cuid())
  taskId    String
  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  deadline  DateTime?
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  progress  SubTaskProgress[]
}

model TaskResource {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type        String   @default("URL")
  title       String
  url         String
  description String?
  createdAt   DateTime @default(now())
}

model TaskAssignment {
  id          String            @id @default(cuid())
  taskId      String
  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation("TaskAssignee", fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  progress    SubTaskProgress[]

  @@unique([taskId, userId])
}

model SubTaskProgress {
  id           String         @id @default(cuid())
  assignmentId String
  assignment   TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  subtaskId    String
  subtask      SubTask        @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  completed    Boolean        @default(false)
  completedAt  DateTime?

  @@unique([assignmentId, subtaskId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("TaskCommenter", fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("TASK")
  read      Boolean  @default(false)
  relatedId String?
  createdAt DateTime @default(now())
}

model StageProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageId     String
  stage       Stage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  attempts    Int       @default(0)
  bestScore   Int?
  passed      Boolean   @default(false)
  docRead     Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, stageId])
}
